# ================================================================
# UKM iKRAAMUL QUR'AN — Environment Variables Template
# Copy file ini menjadi .env dan isi nilainya
# ================================================================

# ----------------------------------------------------------------
# [WAJIB] Google Gemini AI API Key
# Dapatkan dari: https://aistudio.google.com/apikey
# ----------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ----------------------------------------------------------------
# [WAJIB di Vercel/Railway] MySQL Database
# Vercel TIDAK support file system — wajib pakai MySQL eksternal!
# Rekomendasi gratis: PlanetScale (planetscale.com) atau Aiven (aiven.io)
# ----------------------------------------------------------------
DB_HOST="your_mysql_host"
DB_PORT=3306
DB_USER="your_mysql_user"
DB_PASSWORD="your_mysql_password"
DB_NAME="ikraamul_quran_db"

# ----------------------------------------------------------------
# [OPSIONAL] Server Configuration
# PORT biasanya diset otomatis oleh platform (Vercel/Railway)
# ----------------------------------------------------------------
PORT=3000
NODE_ENV="production"

# ----------------------------------------------------------------
# [OPSIONAL] App URL (diisi otomatis oleh platform)
# Contoh: https://ukm-ikraamul-quran-dashboard.vercel.app
# ----------------------------------------------------------------
APP_URL="https://your-app.vercel.app"
